---
import { formatTimestamp, initialsFor } from '../lib/format';
import type { FeedPost } from '../lib/feed';
import type { Identity } from '../lib/auth';

interface Props {
	post: FeedPost;
	identity: Identity | null;
	admin: boolean;
}

const { post, identity, admin } = Astro.props;
---

<div class="border-b border-stone-200 pb-5">
	<div class="flex items-center gap-2.5 mb-2">
		{post.avatar_key ? (
			<img src={`/img/${post.avatar_key}?w=64`} alt="" class="h-9 w-9 rounded-full object-cover" />
		) : (
			<span class="h-9 w-9 rounded-full bg-navy/10 text-navy flex items-center justify-center text-xs font-bold">
				{initialsFor(post.author_name)}
			</span>
		)}
		<div class="leading-tight">
			<p class="text-sm font-semibold text-stone-900">{post.author_name}</p>
			<p class="text-xs text-stone-400">
				{formatTimestamp(post.created_at)}
				{post.updated_at !== post.created_at && ' · edited'}
			</p>
		</div>
	</div>

	{post.tags.length > 0 && (
		<p class="text-xs text-stone-500 mb-1.5">with {post.tags.map((t) => t.display_name).join(', ')}</p>
	)}

	{post.body && <p class="text-[15px] text-stone-800 leading-relaxed whitespace-pre-wrap mb-2">{post.body}</p>}

	{post.link_url && (
		<a href={post.link_url} target="_blank" rel="noopener noreferrer" class="link text-sm block mb-2 break-all">
			{post.link_url}
		</a>
	)}

	{post.media.length > 0 && (
		<div class="-mx-4 mb-2 flex overflow-x-auto snap-x snap-mandatory">
			{post.media.map((m) =>
				m.kind === 'image' ? (
					<button type="button" class="feed-lightbox-trigger block w-full shrink-0 snap-start" data-full={`/img/${m.r2_key}?w=1400`} data-kind="image">
						<img src={`/img/${m.r2_key}?w=800`} alt="" class="w-full aspect-square object-cover" loading="lazy" />
					</button>
				) : (
					<video src={`/img/${m.r2_key}`} controls preload="none" class="w-full shrink-0 snap-start aspect-square bg-black object-cover" />
				),
			)}
		</div>
	)}

	<div class="flex items-center gap-4 text-sm text-stone-500">
		{identity ? (
			<form method="POST" action={`/api/feed/${post.id}/react`}>
				<button type="submit" class={post.iReacted ? 'text-flag-red font-medium' : 'hover:text-flag-red'}>
					{post.iReacted ? '♥' : '♡'} {post.reactionCount > 0 && post.reactionCount}
				</button>
			</form>
		) : (
			post.reactionCount > 0 && <span>♥ {post.reactionCount}</span>
		)}

		{post.isOwn && (
			<details class="inline-block">
				<summary class="cursor-pointer hover:text-navy select-none">edit</summary>
				<form method="POST" action={`/api/feed/${post.id}/edit`} class="flex flex-col gap-2 mt-2">
					<textarea name="body" class="field text-sm" rows={2}>
						{post.body}
					</textarea>
					<input type="text" name="link_url" value={post.link_url ?? ''} placeholder="Link (optional)" class="field text-sm" />
					<button type="submit" class="btn text-sm px-3 self-start">
						Save
					</button>
				</form>
			</details>
		)}

		{(post.isOwn || admin) && (
			<form method="POST" action={`/api/feed/${post.id}/delete`}>
				<button type="submit" class="link-danger">
					delete
				</button>
			</form>
		)}
	</div>

	{(post.replies.length > 0 || identity) && (
		<div class="mt-3 flex flex-col gap-2 pl-3 border-l-2 border-stone-200">
			{post.replies.map((reply) => (
				<div class="flex items-start gap-2 text-sm">
					{reply.avatar_key ? (
						<img src={`/img/${reply.avatar_key}?w=48`} alt="" class="h-6 w-6 rounded-full object-cover shrink-0 mt-0.5" />
					) : (
						<span class="h-6 w-6 rounded-full bg-navy/10 text-navy flex items-center justify-center text-[10px] font-bold shrink-0 mt-0.5">
							{initialsFor(reply.display_name)}
						</span>
					)}
					<p>
						<span class="font-semibold text-stone-900">{reply.display_name}</span>{' '}
						<span class="text-stone-700">{reply.body}</span>
						{(identity?.memberId === reply.member_id || admin) && (
							<form method="POST" action={`/api/feed/comments/${reply.id}/delete`} class="inline">
								<button type="submit" class="link-danger text-xs ml-1">
									delete
								</button>
							</form>
						)}
					</p>
				</div>
			))}
			{identity && (
				<form method="POST" action={`/api/feed/${post.id}/reply`} class="flex gap-2 mt-1">
					<input type="text" name="body" required placeholder="Reply..." class="field text-sm flex-1" />
					<button type="submit" class="btn text-sm px-3">
						Send
					</button>
				</form>
			)}
		</div>
	)}
</div>
