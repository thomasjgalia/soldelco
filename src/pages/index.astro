---
import Layout from '../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
import { isAdmin } from '../lib/admin';
import { getRecentPosts } from '../lib/feed';
import PostCard from '../components/PostCard.astro';
import ComposeDialog from '../components/ComposeDialog.astro';
import FeedLightbox from '../components/FeedLightbox.astro';

const { results: photos } = await env.DB.prepare(
	"SELECT r2_key FROM photos WHERE kind = 'image' ORDER BY RANDOM() LIMIT 15",
).all<{ r2_key: string }>();

const urls = photos.map((p) => `/img/${p.r2_key}?w=800`);

const nextEvent = await env.DB.prepare(
	"SELECT slug, title, starts_at, location FROM events WHERE starts_at >= date('now') ORDER BY starts_at ASC LIMIT 1",
).first<{ slug: string; title: string; starts_at: string; location: string | null }>();

const identity = Astro.locals.identity ?? null;
const admin = identity ? await isAdmin(identity.memberId) : false;
const posts = await getRecentPosts(env, identity, 3);

const { results: members } = await env.DB.prepare(
	"SELECT id, display_name FROM members ORDER BY COALESCE(last_name, display_name), COALESCE(first_name, '')",
).all<{ id: number; display_name: string }>();
---

<Layout>
	{
		urls.length > 0 && (
			<div class="relative mx-auto mb-6 aspect-[4/3] w-full max-w-2xl overflow-hidden rounded-lg bg-stone-200 sm:aspect-video">
				<img id="carousel-a" class="absolute inset-0 h-full w-full object-cover transition-opacity duration-700" alt="" decoding="async" />
				<img
					id="carousel-b"
					class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-700"
					alt=""
					decoding="async"
				/>
			</div>
		)
	}

	<div class="text-center mt-8">
		<h1 class="text-3xl font-bold mb-2">SOL</h1>

		{
			nextEvent && (
				<a href={`/events/${nextEvent.slug}`} class="mt-6 inline-block rounded-lg border border-stone-200 bg-white px-5 py-3 shadow-sm">
					<p class="text-xs font-medium uppercase tracking-wide text-flag-red">Next up</p>
					<p class="font-semibold text-navy">{nextEvent.title}</p>
					<p class="text-sm text-stone-500">
						{nextEvent.starts_at}
						{nextEvent.location && ` · ${nextEvent.location}`}
					</p>
				</a>
			)
		}

		{identity && (
			<div class="mt-4">
				<ComposeDialog members={members} redirectTo="/" />
			</div>
		)}
	</div>

	<div class="text-left mt-10">
		<div class="flex items-center justify-between mb-3">
			<h2 class="section-title mb-0">Recent posts</h2>
			<a href="/feed" class="link text-sm">
				See all
			</a>
		</div>
		<div class="flex flex-col gap-6">
			{posts.map((post) => <PostCard post={post} identity={identity} admin={admin} />)}
			{posts.length === 0 && <p class="text-stone-500 text-sm">Nothing posted yet.</p>}
		</div>
	</div>

	<FeedLightbox />
</Layout>

<script define:vars={{ urls }}>
	if (urls.length > 0) {
		const imgs = [document.getElementById('carousel-a'), document.getElementById('carousel-b')];
		let active = 0;
		let index = 0;

		imgs[0].src = urls[0];

		if (urls.length > 1) {
			setInterval(() => {
				index = (index + 1) % urls.length;
				const next = (active + 1) % 2;
				imgs[next].src = urls[index];
				imgs[next].classList.remove('opacity-0');
				imgs[active].classList.add('opacity-0');
				active = next;
			}, 5000);
		}
	}
</script>
