---
import Layout from '../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';

const { results: members } = await env.DB.prepare(
	"SELECT id, display_name, avatar_key, email, phone, birthday, address FROM members ORDER BY COALESCE(last_name, display_name), COALESCE(first_name, '')",
).all<{
	id: number;
	display_name: string;
	avatar_key: string | null;
	email: string | null;
	phone: string | null;
	birthday: string | null;
	address: string | null;
}>();

const MONTH_NAMES = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
function formatBirthday(mmdd: string): string {
	const [month, day] = mmdd.split('-').map(Number);
	return `${MONTH_NAMES[month - 1]} ${day}`;
}
---

<Layout title="Sons of Liberty">
	<h1 class="page-title">Sons of Liberty</h1>

	<div class="grid grid-cols-3 sm:grid-cols-4 gap-4">
		{
			members.map((m) => (
				<details class="group [&::-webkit-details-marker]:hidden [&_summary]:marker:content-none">
					<summary class="flex flex-col items-center text-center gap-1.5 cursor-pointer list-none">
						{m.avatar_key ? (
							<img src={`/img/${m.avatar_key}?w=160`} alt={m.display_name} class="h-16 w-16 rounded-full object-cover" />
						) : (
							<span class="h-16 w-16 rounded-full bg-navy/10 text-navy flex items-center justify-center text-lg font-bold">
								{m.display_name
									.split(' ')
									.map((p) => p[0])
									.join('')
									.slice(0, 2)
									.toUpperCase()}
							</span>
						)}
						<p class="text-xs font-medium leading-tight">{m.display_name}</p>
					</summary>
					{m.email || m.phone || m.birthday || m.address ? (
						<div class="text-[11px] text-stone-500 text-center mt-1 leading-tight break-words">
							{m.email && <p>{m.email}</p>}
							{m.phone && <p>{m.phone}</p>}
							{m.birthday && <p>🎂 {formatBirthday(m.birthday)}</p>}
							{m.address && <p>{m.address}</p>}
						</div>
					) : (
						<p class="text-[11px] text-stone-400 text-center mt-1">No contact info yet</p>
					)}
				</details>
			))
		}
		{members.length === 0 && <p class="text-stone-500">No members yet.</p>}
	</div>
</Layout>
