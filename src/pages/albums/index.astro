---
import Layout from '../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';

const identity = Astro.locals.identity;

const { results: albums } = await env.DB.prepare(
	`SELECT albums.id, albums.slug, albums.title,
		COALESCE(
			(SELECT r2_key FROM photos WHERE photos.album_id = albums.id AND photos.kind = 'image' ORDER BY created_at ASC LIMIT 1),
			(SELECT poster_key FROM photos WHERE photos.album_id = albums.id AND photos.kind = 'video' AND poster_key IS NOT NULL ORDER BY created_at ASC LIMIT 1)
		) as cover_key
	 FROM albums
	 ORDER BY COALESCE(albums.occurred_at, albums.created_at) DESC`,
).all<{ id: number; slug: string; title: string; cover_key: string | null }>();
---

<Layout title="Albums">
	<a href="/timeline" class="link-muted">&larr; Timeline</a>
	<h1 class="page-title mt-1">All Albums</h1>

	{
		!identity ? (
			<p class="text-stone-500 text-sm mb-4">
				<a href="/whoami?redirect=/albums" class="link">
					Pick your name
				</a>{' '}
				to create an album.
			</p>
		) : (
			<form method="POST" action="/api/albums" class="flex gap-2 mb-4">
				<input type="text" name="title" required placeholder="New album title" class="field flex-1" />
				<button type="submit" class="btn shrink-0">
					Create
				</button>
			</form>
		)
	}

	<div class="grid grid-cols-2 gap-3">
		{
			albums.map((album) => (
				<a href={`/albums/${album.slug}`} class="block">
					<div class="aspect-square bg-stone-200 rounded-lg overflow-hidden mb-1">
						{album.cover_key && (
							<img src={`/img/${album.cover_key}?w=400`} alt={album.title} class="w-full h-full object-cover" loading="lazy" />
						)}
					</div>
					<p class="text-sm font-medium">{album.title}</p>
				</a>
			))
		}
		{albums.length === 0 && <p class="text-stone-500">No albums yet.</p>}
	</div>
</Layout>
