---
import Layout from '../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';

const { slug } = Astro.params;
const identity = Astro.locals.identity;
if (!identity) return Astro.redirect(`/whoami?redirect=${encodeURIComponent(Astro.url.pathname)}`);

const album = await env.DB.prepare('SELECT id, title, description FROM albums WHERE slug = ?')
	.bind(slug)
	.first<{ id: number; title: string; description: string | null }>();

if (!album) return Astro.redirect('/albums');

const { results: photos } = await env.DB.prepare(
	'SELECT id, r2_key, kind, caption, poster_key FROM photos WHERE album_id = ? ORDER BY created_at ASC',
)
	.bind(album.id)
	.all<{ id: number; r2_key: string; kind: string; caption: string | null; poster_key: string | null }>();

const images = photos.filter((p) => p.kind === 'image');

const tagsByPhoto = new Map<number, { member_id: number; display_name: string }[]>();
if (images.length > 0) {
	const { results: tagRows } = await env.DB.prepare(
		`SELECT photo_tags.photo_id, members.id as member_id, members.display_name
		 FROM photo_tags JOIN members ON members.id = photo_tags.member_id
		 WHERE photo_tags.photo_id IN (${images.map(() => '?').join(',')})
		 ORDER BY members.display_name`,
	)
		.bind(...images.map((p) => p.id))
		.all<{ photo_id: number; member_id: number; display_name: string }>();
	for (const row of tagRows) {
		if (!tagsByPhoto.has(row.photo_id)) tagsByPhoto.set(row.photo_id, []);
		tagsByPhoto.get(row.photo_id)!.push({ member_id: row.member_id, display_name: row.display_name });
	}
}
const lightboxData = images.map((p) => ({ id: p.id, tags: tagsByPhoto.get(p.id) ?? [] }));

const { results: members } = await env.DB.prepare(
	"SELECT id, display_name FROM members ORDER BY COALESCE(last_name, display_name), COALESCE(first_name, '')",
).all<{ id: number; display_name: string }>();
---

<Layout title={album.title}>
	<a href="/albums" class="link-muted">&larr; All albums</a>
	<h1 class="page-title mt-1">{album.title}</h1>
	{album.description && <p class="text-stone-600 mb-4">{album.description}</p>}

	<form id="album-upload-form" method="POST" action={`/api/albums/${album.id}/photos`} enctype="multipart/form-data" class="flex gap-2 mb-4">
		<input type="file" name="files" accept="image/*,video/*" multiple required class="field flex-1" />
		<button type="submit" class="btn shrink-0">
			Add photos
		</button>
	</form>

	<div class="columns-2 sm:columns-3 gap-2 mt-4">
		{
			photos.map((photo) =>
				photo.kind === 'image' ? (
					<button
						type="button"
						class="photo-thumb mb-2 block w-full break-inside-avoid"
						data-full={`/img/${photo.r2_key}?w=1400`}
						data-index={images.findIndex((p) => p.id === photo.id)}
					>
						<img src={`/img/${photo.r2_key}?w=400`} alt={photo.caption ?? ''} class="w-full rounded" loading="lazy" />
					</button>
				) : (
					<video
						src={`/video/${photo.r2_key}`}
						poster={photo.poster_key ? `/img/${photo.poster_key}?w=800` : undefined}
						controls
						preload="none"
						class="mb-2 w-full break-inside-avoid rounded bg-black"
					/>
				),
			)
		}
		{photos.length === 0 && <p class="text-stone-500">No photos yet.</p>}
	</div>

	<div id="lightbox" class="fixed inset-0 bg-black/90 hidden flex-col z-50" role="dialog" aria-hidden="true">
		<div class="relative flex-1 min-h-0 flex items-center justify-center">
			<button type="button" id="lightbox-close" class="absolute top-4 right-4 text-white text-2xl leading-none" aria-label="Close">
				&times;
			</button>
			<button
				type="button"
				id="lightbox-prev"
				class="absolute left-2 top-1/2 -translate-y-1/2 text-white text-3xl px-2"
				aria-label="Previous"
			>
				&#8249;
			</button>
			<img id="lightbox-img" src="" alt="" class="max-h-full max-w-[92vw] object-contain" />
			<button
				type="button"
				id="lightbox-next"
				class="absolute right-2 top-1/2 -translate-y-1/2 text-white text-3xl px-2"
				aria-label="Next"
			>
				&#8250;
			</button>
		</div>

		<!-- Not absolutely positioned to the viewport bottom -- on mobile
		     Safari that risks landing behind the browser's own bottom
		     toolbar. This is a normal-flow footer, always right below the
		     visible image. -->
		<div class="shrink-0 bg-black/80 px-4 py-3 flex flex-col items-center gap-2 text-sm text-white">
			<div id="lightbox-tag-list" class="flex flex-wrap gap-1.5 justify-center max-w-[92vw]" />
			{
				identity && (
					<label class="flex gap-1.5 items-center">
						<span class="text-white/70">Tag someone:</span>
						<select id="lightbox-tag-select" class="text-stone-900 rounded px-2 py-1 text-sm">
							<option value="">Choose a name...</option>
							{members.map((m) => (
								<option value={m.id}>{m.display_name}</option>
							))}
						</select>
					</label>
				)
			}
		</div>
	</div>
</Layout>

<script type="application/json" id="lightbox-photo-data" set:html={JSON.stringify(lightboxData)} />

<script>
	import { capturePosterFromFile } from '../../lib/client/posterCapture';

	const uploadForm = document.getElementById('album-upload-form') as HTMLFormElement | null;
	uploadForm?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const submitBtn = uploadForm.querySelector('button[type="submit"]') as HTMLButtonElement;
		const originalLabel = submitBtn.textContent;
		submitBtn.disabled = true;
		submitBtn.textContent = 'Uploading...';

		const fileInput = uploadForm.querySelector('input[type="file"]') as HTMLInputElement;
		const selectedFiles = Array.from(fileInput.files ?? []);

		// Videos get their poster generated and inserted immediately after
		// them -- uploadPhotosToAlbum relies on exactly this adjacency.
		const orderedFiles: File[] = [];
		for (const file of selectedFiles) {
			orderedFiles.push(file);
			if (file.type.startsWith('video/')) {
				const poster = await capturePosterFromFile(file);
				if (poster) orderedFiles.push(poster);
			}
		}

		const formData = new FormData();
		for (const file of orderedFiles) formData.append('files', file);

		try {
			const res = await fetch(uploadForm.action, { method: 'POST', body: formData });
			window.location.href = res.url || uploadForm.action;
		} catch {
			submitBtn.disabled = false;
			submitBtn.textContent = originalLabel;
			alert('Failed to upload. Try again.');
		}
	});

	type Tag = { member_id: number; display_name: string };
	type PhotoData = { id: number; tags: Tag[] };

	const photoDataEl = document.getElementById('lightbox-photo-data');
	const photoData: PhotoData[] = photoDataEl?.textContent ? JSON.parse(photoDataEl.textContent) : [];

	const tagListEl = document.getElementById('lightbox-tag-list');
	const tagSelect = document.getElementById('lightbox-tag-select') as HTMLSelectElement | null;

	function renderTags(index: number) {
		const photo = photoData[index];
		if (!tagListEl || !photo) return;
		tagListEl.innerHTML = '';
		photo.tags.forEach((tag) => {
			const pill = document.createElement('span');
			pill.className = 'inline-flex items-center gap-1 bg-white/20 rounded-full px-2 py-0.5';
			pill.textContent = tag.display_name;
			if (tagSelect) {
				const removeBtn = document.createElement('button');
				removeBtn.type = 'button';
				removeBtn.textContent = '×';
				removeBtn.className = 'text-white/70 hover:text-white leading-none';
				removeBtn.addEventListener('click', () => removeTag(photo.id, tag.member_id));
				pill.appendChild(removeBtn);
			}
			tagListEl.appendChild(pill);
		});
		if (tagSelect) {
			Array.from(tagSelect.options).forEach((opt) => {
				if (!opt.value) return;
				opt.hidden = photo.tags.some((t) => String(t.member_id) === opt.value);
			});
			tagSelect.value = '';
		}
	}

	async function addTag(photoId: number, memberId: number) {
		const formData = new FormData();
		formData.append('memberId', String(memberId));
		const res = await fetch(`/api/photos/${photoId}/tags`, { method: 'POST', body: formData });
		if (!res.ok) return;
		const data = (await res.json()) as { tags: Tag[] };
		const photo = photoData.find((p) => p.id === photoId);
		if (photo) photo.tags = data.tags;
		renderTags(current);
	}

	async function removeTag(photoId: number, memberId: number) {
		const res = await fetch(`/api/photos/${photoId}/tags?memberId=${memberId}`, { method: 'DELETE' });
		if (!res.ok) return;
		const data = (await res.json()) as { tags: Tag[] };
		const photo = photoData.find((p) => p.id === photoId);
		if (photo) photo.tags = data.tags;
		renderTags(current);
	}

	tagSelect?.addEventListener('change', () => {
		const photo = photoData[current];
		const memberId = Number(tagSelect.value);
		if (photo && memberId) addTag(photo.id, memberId);
	});

	const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>('.photo-thumb'));
	const urls = thumbs.map((t) => t.dataset.full!);
	const lightbox = document.getElementById('lightbox')!;
	const img = document.getElementById('lightbox-img') as HTMLImageElement;
	let current = 0;

	function show(index: number) {
		current = (index + urls.length) % urls.length;
		img.src = urls[current];
		renderTags(current);
		lightbox.classList.remove('hidden');
		lightbox.classList.add('flex');
		lightbox.setAttribute('aria-hidden', 'false');
	}

	function close() {
		lightbox.classList.add('hidden');
		lightbox.classList.remove('flex');
		lightbox.setAttribute('aria-hidden', 'true');
		img.src = '';
	}

	thumbs.forEach((thumb) => {
		thumb.addEventListener('click', () => show(Number(thumb.dataset.index)));
	});

	document.getElementById('lightbox-close')!.addEventListener('click', close);
	document.getElementById('lightbox-prev')!.addEventListener('click', () => show(current - 1));
	document.getElementById('lightbox-next')!.addEventListener('click', () => show(current + 1));
	lightbox.addEventListener('click', (e) => {
		if (e.target === lightbox) close();
	});
	document.addEventListener('keydown', (e) => {
		if (lightbox.classList.contains('hidden')) return;
		if (e.key === 'Escape') close();
		if (e.key === 'ArrowLeft') show(current - 1);
		if (e.key === 'ArrowRight') show(current + 1);
	});
</script>
