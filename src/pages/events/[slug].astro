---
import Layout from '../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
import { sortTeams, winningTeams, type Team } from '../../lib/results';

const { slug } = Astro.params;
const identity = Astro.locals.identity;

const event = await env.DB.prepare('SELECT id, title, description, location, starts_at, ends_at FROM events WHERE slug = ?')
	.bind(slug)
	.first<{
		id: number;
		title: string;
		description: string | null;
		location: string | null;
		starts_at: string | null;
		ends_at: string | null;
	}>();

if (!event) return Astro.redirect('/events');

const { results: albums } = await env.DB.prepare('SELECT slug, title FROM albums WHERE event_id = ?')
	.bind(event.id)
	.all<{ slug: string; title: string }>();

const { results: rawActivities } = await env.DB.prepare(
	'SELECT id, kind, title, rsvp_closes_at FROM competitions WHERE event_id = ? ORDER BY played_on, created_at',
)
	.bind(event.id)
	.all<{ id: number; kind: string; title: string; rsvp_closes_at: string | null }>();

const activities = await Promise.all(
	rawActivities.map(async (activity) => {
		const myResponse = identity
			? await env.DB.prepare('SELECT attending FROM rsvp_responses WHERE competition_id = ? AND member_id = ?')
					.bind(activity.id, identity.memberId)
					.first<{ attending: string | null }>()
			: null;
		const rsvpClosed = activity.rsvp_closes_at ? new Date(activity.rsvp_closes_at) < new Date() : false;

		let teams: Team[] = [];
		let rosterByTeam = new Map<number, string[]>();
		let winnerIds = new Set<number>();
		if (activity.kind !== 'rsvp_only') {
			const { results: teamRows } = await env.DB.prepare('SELECT id, competition_id, name, score, placement FROM teams WHERE competition_id = ?')
				.bind(activity.id)
				.all<Team>();
			const { results: teamMembers } = await env.DB.prepare(
				`SELECT team_members.team_id, members.display_name
				 FROM team_members JOIN members ON members.id = team_members.member_id
				 WHERE team_members.team_id IN (SELECT id FROM teams WHERE competition_id = ?)`,
			)
				.bind(activity.id)
				.all<{ team_id: number; display_name: string }>();
			for (const tm of teamMembers) {
				if (!rosterByTeam.has(tm.team_id)) rosterByTeam.set(tm.team_id, []);
				rosterByTeam.get(tm.team_id)!.push(tm.display_name);
			}
			teams = sortTeams(teamRows);
			winnerIds = new Set(winningTeams(teamRows).map((t) => t.id));
		}

		return {
			...activity,
			isScored: activity.kind === 'score',
			attending: myResponse?.attending ?? null,
			rsvpClosed,
			teams,
			rosterByTeam,
			winnerIds,
		};
	}),
);
---

<Layout title={event.title}>
	<a href="/events" class="link-muted">&larr; All events</a>
	<h1 class="text-2xl font-bold mt-1 mb-1">{event.title}</h1>
	<p class="text-sm text-stone-500 mb-1">
		{event.starts_at}
		{event.ends_at && event.ends_at !== event.starts_at && ` – ${event.ends_at}`}
		{event.location && ` · ${event.location}`}
	</p>
	{event.description && <p class="text-stone-600 mb-4">{event.description}</p>}

	{
		albums.length > 0 && (
			<div class="mb-6">
				<h2 class="section-title">Photos</h2>
				<ul class="flex flex-col gap-1">
					{albums.map((album) => (
						<li>
							<a href={`/albums/${album.slug}`} class="link">
								{album.title}
							</a>
						</li>
					))}
				</ul>
			</div>
		)
	}

	{
		activities.map((a) => (
			<div class="mb-5 max-w-sm">
				<div class="flex items-center justify-between gap-2">
					<h2 class="section-title mb-0">{a.title}</h2>
					{a.rsvpClosed ? (
						<span class="text-xs text-stone-500 shrink-0">RSVPs closed</span>
					) : !identity ? (
						<a href={`/whoami?redirect=/events/${slug}`} class="link text-xs shrink-0">
							Pick your name
						</a>
					) : (
						<form method="POST" action={`/api/rsvp/${a.id}`} class="flex gap-1 shrink-0">
							<button type="submit" name="attending" value="yes" class={`rsvp-btn rsvp-btn-yes ${a.attending === 'yes' ? 'is-selected' : ''}`} aria-label="Yes, I'm in" title="Yes">
								&#10003;
							</button>
							<button type="submit" name="attending" value="maybe" class={`rsvp-btn rsvp-btn-maybe ${a.attending === 'maybe' ? 'is-selected' : ''}`} aria-label="Maybe" title="Maybe">
								?
							</button>
							<button type="submit" name="attending" value="no" class={`rsvp-btn rsvp-btn-no ${a.attending === 'no' ? 'is-selected' : ''}`} aria-label="Can't make it" title="No">
								&#10007;
							</button>
						</form>
					)}
				</div>

				{a.teams.length > 0 && (
					<ul class="flex flex-col divide-y divide-stone-200 mt-2">
						{a.teams.map((team) => (
							<li class="py-2 flex items-center justify-between gap-4">
								<div>
									<p class="font-medium">
										{team.name} {a.winnerIds.has(team.id) && '🏆'}
									</p>
									<p class="text-xs text-stone-500">{(a.rosterByTeam.get(team.id) ?? []).join(', ')}</p>
								</div>
								<span class="text-sm text-stone-500 shrink-0">{a.isScored ? team.score : `#${team.placement}`}</span>
							</li>
						))}
					</ul>
				)}
			</div>
		))
	}
	{activities.length === 0 && <p class="text-stone-500 text-sm">Nothing planned yet.</p>}
</Layout>
