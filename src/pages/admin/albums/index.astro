---
import Layout from '../../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
import { isAdmin } from '../../../lib/admin';

const identity = Astro.locals.identity;
if (!identity) return Astro.redirect(`/whoami?redirect=${encodeURIComponent(Astro.url.pathname)}`);
if (!(await isAdmin(identity.memberId))) return Astro.redirect('/');

const today = new Date().toISOString().slice(0, 10);

const { results: albums } = await env.DB.prepare(
	`SELECT albums.id, albums.slug, albums.title, COUNT(photos.id) as photo_count
	 FROM albums
	 LEFT JOIN photos ON photos.album_id = albums.id
	 GROUP BY albums.id
	 ORDER BY albums.created_at DESC`,
).all<{ id: number; slug: string; title: string; photo_count: number }>();
---

<Layout title="Manage albums">
	<h1 class="page-title">Albums</h1>

	<form method="POST" action="/api/admin/albums" class="form-stack mb-8">
		<input type="text" name="title" required placeholder="Album title" class="field" />
		<div>
			<label for="new-album-date" class="text-xs text-stone-500 block mb-1">When did this happen?</label>
			<input id="new-album-date" type="date" name="occurredAt" value={today} class="field" />
		</div>
		<label class="flex items-center gap-2 text-sm">
			<input type="checkbox" name="isSolWeekend" checked />
			This is a SOL Weekend album
		</label>
		<button type="submit" class="btn">Create album</button>
	</form>

	<ul class="flex flex-col divide-y divide-stone-200">
		{
			albums.map((album) => (
				<li class="py-3 flex items-center justify-between">
					<a href={`/admin/albums/${album.id}`} class="font-medium hover:underline">
						{album.title}
					</a>
					<span class="text-sm text-stone-500">{album.photo_count} photos</span>
				</li>
			))
		}
		{albums.length === 0 && <li class="py-3 text-stone-500">No albums yet.</li>}
	</ul>
</Layout>
