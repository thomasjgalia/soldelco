---
import Layout from '../../layouts/Layout.astro';
import { isAdmin } from '../../lib/admin';

const identity = Astro.locals.identity;
if (!identity) return Astro.redirect(`/whoami?redirect=${encodeURIComponent(Astro.url.pathname)}`);
if (!(await isAdmin(identity.memberId))) return Astro.redirect('/');
---

<Layout title="Admin">
	<h1 class="page-title">Admin</h1>
	<ul class="flex flex-col gap-2">
		<li><a href="/admin/albums" class="link">Manage albums &amp; photos</a></li>
		<li><a href="/admin/events" class="link">Manage events &amp; activities</a></li>
		<li><a href="/admin/members" class="link">Manage members</a></li>
		<li><a href="/admin/activity" class="link">View activity</a></li>
		<li><a href="/admin/notify" class="link">Send a notification</a></li>
		<li><a href="/admin/backfill-posters" class="link">Backfill video thumbnails</a></li>
	</ul>
</Layout>
