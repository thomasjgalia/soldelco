---
import Layout from '../layouts/Layout.astro';

const identity = Astro.locals.identity;
---

<Layout title="Install the App">
	<h1 class="page-title">Install SOL</h1>
	<p class="text-stone-600 mb-8">
		Add SOL to your home screen for a real app-like experience -- full screen, its own icon, and push notifications for
		replies, tags, and announcements.
	</p>

	<section class="mb-8">
		<h2 class="section-title">iPhone / iPad</h2>
		<ol class="space-y-4 text-sm text-stone-700">
			<li class="flex flex-col gap-2">
				<span>
					1. Tap the <strong>Share</strong> icon (a square with an arrow pointing up) in the toolbar.
				</span>
				<img src="/install/1-share.jpeg" alt="Tapping the Share icon in the browser toolbar" class="rounded-lg border border-stone-200 max-w-[260px]" />
			</li>
			<li class="flex flex-col gap-2">
				<span>
					2. Scroll down and tap <strong>"Add to Home Screen."</strong>
				</span>
				<img src="/install/2-add-to-home-screen.jpeg" alt="The Add to Home Screen option in the share sheet" class="rounded-lg border border-stone-200 max-w-[260px]" />
			</li>
			<li class="flex flex-col gap-2">
				<span>
					3. Tap <strong>"Add"</strong> in the top right.
				</span>
				<img src="/install/3-web-app.jpeg" alt="The Add to Home Screen confirmation screen" class="rounded-lg border border-stone-200 max-w-[260px]" />
			</li>
		</ol>
		<p class="text-xs text-stone-500 mt-3">
			Then open SOL from the new icon on your home screen (not from the browser) before enabling notifications below.
		</p>
	</section>

	<section class="mb-8">
		<h2 class="section-title">Android (Chrome)</h2>
		<button type="button" id="android-install-btn" class="btn hidden mb-2">
			Install app
		</button>
		<p id="android-fallback" class="text-sm text-stone-700">
			Tap the menu (⋮) in the top right, then <strong>"Install app"</strong> or <strong>"Add to Home screen."</strong>
		</p>
	</section>

	<section>
		<h2 class="section-title">Enable notifications</h2>
		{
			identity ? (
				<>
					<button type="button" class="push-opt-in-btn btn hidden" />
					<p class="text-xs text-stone-500 mt-2">
						Once you've installed it above, open SOL from its home screen icon (not the browser) before tapping this --
						on iPhone, notifications only work from the installed app.
					</p>
				</>
			) : (
				<p class="text-sm text-stone-500">
					<a href="/whoami?redirect=/install" class="link">
						Pick your name
					</a>{' '}
					first, then come back here.
				</p>
			)
		}
	</section>
</Layout>

<script>
	// Android/Chrome fires this when it decides the site is installable,
	// which lets us show a real one-tap Install button instead of just
	// pointing people at the browser menu. There's no equivalent on iOS --
	// that side stays fully manual, see the instructions above.
	let deferredPrompt: any = null;
	window.addEventListener('beforeinstallprompt', (e) => {
		e.preventDefault();
		deferredPrompt = e;
		const btn = document.getElementById('android-install-btn');
		const fallback = document.getElementById('android-fallback');
		btn?.classList.remove('hidden');
		fallback?.classList.add('hidden');
		btn?.addEventListener('click', async () => {
			deferredPrompt.prompt();
			await deferredPrompt.userChoice;
			deferredPrompt = null;
			btn.classList.add('hidden');
		});
	});
</script>
