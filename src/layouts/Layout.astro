---
import '../styles/global.css';
import { env } from 'cloudflare:workers';
import { EXTERNAL_LINKS, VAPID_PUBLIC_KEY } from '../config/site';
import { isAdmin } from '../lib/admin';

interface Props {
	title?: string;
}

const { title } = Astro.props;
const identity = Astro.locals.identity;
const admin = identity ? await isAdmin(identity.memberId) : false;
const avatarKey = identity
	? (await env.DB.prepare('SELECT avatar_key FROM members WHERE id = ?').bind(identity.memberId).first<{ avatar_key: string | null }>())
			?.avatar_key ?? null
	: null;
const initials = identity
	?.displayName.split(' ')
	.map((p) => p[0])
	.join('')
	.slice(0, 2)
	.toUpperCase();
const pageTitle = title ? `${title} · SOL` : 'SOL';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/manifest.json" />
		<meta name="theme-color" content="#B31942" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="SOL" />
		<title>{pageTitle}</title>
	</head>
	<body class="min-h-dvh bg-stone-50 text-stone-900 flex flex-col">
		<header class="relative z-50 bg-flag-red">
			<div class="mx-auto max-w-3xl px-4 py-3 flex items-center justify-between gap-4">
				<a href="/" class="flex items-center gap-2 text-lg font-bold tracking-tight text-white">
					<svg viewBox="0 0 64 64" width="24" height="24" fill="currentColor" aria-hidden="true">
						<circle cx="32" cy="25" r="13" />
						<circle cx="19" cy="31" r="10" />
						<circle cx="45" cy="31" r="10" />
						<circle cx="32" cy="35" r="11" />
						<polygon points="28,37 36,37 34,57 30,57" />
						<polygon points="25,57 39,57 41,60 23,60" />
					</svg>
					SOL
				</a>

				<div class="flex items-center gap-3">
					<nav
						id="site-nav"
						class="hidden flex-col gap-1 absolute inset-x-0 top-full border-b border-stone-200 bg-white px-4 py-3 shadow-md sm:static sm:flex sm:flex-row sm:items-center sm:gap-4 sm:border-0 sm:bg-transparent sm:p-0 sm:shadow-none text-sm font-medium"
					>
						<a href="/feed" class="py-1 text-stone-900 hover:text-navy hover:underline sm:py-0 sm:text-white sm:hover:underline">Feed</a>
						<a href="/albums" class="py-1 text-stone-900 hover:text-navy hover:underline sm:py-0 sm:text-white sm:hover:underline">Albums</a>
						<a href="/events" class="py-1 text-stone-900 hover:text-navy hover:underline sm:py-0 sm:text-white sm:hover:underline">Events</a>
						<a href="/records" class="py-1 text-stone-900 hover:text-navy hover:underline sm:py-0 sm:text-white sm:hover:underline">Records</a>
						<a href="/members" class="py-1 text-stone-900 hover:text-navy hover:underline sm:py-0 sm:text-white sm:hover:underline">Sons of Liberty</a>
						<a href="/install" class="py-1 text-stone-900 hover:text-navy hover:underline sm:py-0 sm:text-white sm:hover:underline">Install</a>
						<a
							href={EXTERNAL_LINKS.golf}
							target="_blank"
							rel="noopener noreferrer"
							class="py-1 flex items-center gap-1.5 text-stone-900 hover:text-navy hover:underline sm:py-0 sm:text-white sm:hover:underline"
						>
							<img src="/golf-favicon.png" alt="" class="h-4 w-4 shrink-0" />
							Golf
						</a>
						<a
							href={EXTERNAL_LINKS.cornhole}
							target="_blank"
							rel="noopener noreferrer"
							class="py-1 flex items-center gap-1.5 text-stone-900 hover:text-navy hover:underline sm:py-0 sm:text-white sm:hover:underline"
						>
							<img src="/cornhole-favicon.png" alt="" class="h-4 w-4 shrink-0" />
							Cornhole
						</a>
						{admin && (
							<a href="/admin" class="py-1 text-stone-900 hover:text-navy hover:underline sm:py-0 sm:text-white sm:hover:underline">
								Admin
							</a>
						)}
					</nav>

					{identity && (
						<a href="/profile" class="shrink-0" aria-label="My profile" title="My profile">
							{avatarKey ? (
								<img src={`/img/${avatarKey}?w=64`} alt="" class="h-8 w-8 rounded-full object-cover border-2 border-white/50" />
							) : (
								<span class="h-8 w-8 rounded-full bg-white/15 text-white border-2 border-white/50 flex items-center justify-center text-xs font-bold">
									{initials}
								</span>
							)}
						</a>
					)}

					<button
						id="nav-toggle"
						type="button"
						class="sm:hidden -mr-2 p-2 text-white"
						aria-label="Menu"
						aria-expanded="false"
						aria-controls="site-nav"
					>
						<svg
							width="22"
							height="22"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							class="pointer-events-none"
						>
							<line x1="3" y1="6" x2="21" y2="6"></line>
							<line x1="3" y1="12" x2="21" y2="12"></line>
							<line x1="3" y1="18" x2="21" y2="18"></line>
						</svg>
					</button>
				</div>
			</div>
		</header>

		<main class="flex-1 mx-auto w-full max-w-3xl px-4 py-6">
			<slot />
		</main>

		<footer class="border-t border-stone-200 bg-white">
			<div class="mx-auto max-w-3xl px-4 py-3 text-sm text-stone-500 flex items-center justify-between gap-2 flex-wrap">
				{
					identity ? (
						<span>
							Hi, {identity.displayName} ·{' '}
							<a href="/profile" class="underline">
								my profile
							</a>{' '}
							·{' '}
							<a href="/whoami" class="underline">
								not you?
							</a>
						</span>
					) : (
						<a href="/whoami" class="font-medium text-navy underline">
							Who are you?
						</a>
					)
				}
				{identity && <button type="button" class="push-opt-in-btn hidden underline shrink-0" />}
			</div>
		</footer>
		{identity && <span id="vapid-public-key" data-key={VAPID_PUBLIC_KEY} class="hidden" />}
	</body>
</html>

<script>
	function initNavToggle() {
		const toggle = document.getElementById('nav-toggle');
		const nav = document.getElementById('site-nav');
		toggle?.addEventListener('click', () => {
			const nowHidden = nav?.classList.toggle('hidden');
			nav?.classList.toggle('flex', !nowHidden);
			toggle.setAttribute('aria-expanded', String(!nowHidden));
		});
	}
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initNavToggle);
	} else {
		initNavToggle();
	}
</script>

<script>
	// Push notifications need: a service worker (to receive push events even
	// when the site isn't open), the browser's permission, and a saved
	// PushSubscription. On iOS this whole chain only works once the site has
	// actually been added to the home screen -- push silently can't work in
	// a plain Safari tab there -- so the button's label adapts instead of
	// pretending it'll work everywhere.
	function urlBase64ToUint8Array(base64: string): Uint8Array {
		const padding = '='.repeat((4 - (base64.length % 4)) % 4);
		const base64Safe = (base64 + padding).replace(/-/g, '+').replace(/_/g, '/');
		const raw = atob(base64Safe);
		return Uint8Array.from([...raw].map((c) => c.charCodeAt(0)));
	}

	// Every push-opt-in button on the page (the footer's, and the Install
	// page's bigger one) shares this one registration/subscription -- there's
	// only ever one subscription per device regardless of how many buttons
	// can trigger it.
	async function initPush() {
		const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.push-opt-in-btn'));
		const keyEl = document.getElementById('vapid-public-key');
		if (buttons.length === 0 || !keyEl) return; // not signed in -- nothing to wire up

		const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent);
		const isStandalone = window.matchMedia('(display-mode: standalone)').matches || (navigator as any).standalone === true;
		const supported = 'serviceWorker' in navigator && 'PushManager' in window && 'Notification' in window;

		if (!supported) return; // browser can't do push at all -- stay hidden

		if (isIOS && !isStandalone) {
			for (const button of buttons) {
				button.textContent = 'Add to Home Screen to get notifications';
				button.disabled = true;
				button.classList.remove('hidden');
			}
			return;
		}

		const registration = await navigator.serviceWorker.register('/sw.js');

		async function refreshLabel() {
			const existing = await registration.pushManager.getSubscription();
			for (const button of buttons) {
				button.textContent = existing ? 'Notifications on — tap to turn off' : 'Enable notifications';
				button.classList.remove('hidden');
			}
		}

		async function toggle() {
			const existing = await registration.pushManager.getSubscription();
			if (existing) {
				await fetch('/api/push/unsubscribe', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ endpoint: existing.endpoint }),
				});
				await existing.unsubscribe();
				await refreshLabel();
				return;
			}

			const permission = await Notification.requestPermission();
			if (permission !== 'granted') return;

			const subscription = await registration.pushManager.subscribe({
				userVisibleOnly: true,
				applicationServerKey: urlBase64ToUint8Array(keyEl.getAttribute('data-key')!) as BufferSource,
			});
			await fetch('/api/push/subscribe', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(subscription.toJSON()),
			});
			await refreshLabel();
		}

		for (const button of buttons) {
			button.addEventListener('click', toggle);
		}

		await refreshLabel();
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initPush);
	} else {
		initPush();
	}
</script>
